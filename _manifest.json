{
  "manifest_version": 2,
  "id": "github.hhhhhhezeus.bilibili-meme",
  "version": "1.0.0",
  "name": "B站学梗 / Bilibili Meme Learner",
  "description": "从 B站 视频里学梗，并理解群友分享的视频：读字幕、看弹幕爆发点、翻热评，用本地模型整理成结构化梗卡写入麦麦黑话库；含敏感度判定、选源打分与自动降级。",
  "author": {
    "name": "hhhhhhezeus",
    "url": "https://github.com/hhhhhhezeus"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/hhhhhhezeus/bilibili-meme",
    "homepage": "https://github.com/hhhhhhezeus/bilibili-meme",
    "documentation": "https://github.com/hhhhhhezeus/bilibili-meme/blob/main/README.md",
    "issues": "https://github.com/hhhhhhezeus/bilibili-meme/issues"
  },
  "plugin_type": "integration",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.19.0",
    "max_version": "2.20.99"
  },
  "dependencies": [],
  "capabilities": [
    "llm.generate",
    "database.query",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
